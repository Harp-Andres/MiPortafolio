{
  "name": "@mportafolio/core",
  "version": "2.0.0",
  "description": "Core shared data and types for MiPortafolio",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./data": {
      "import": "./dist/data/index.js",
      "types": "./dist/data/index.d.ts"
    },
    "./types": {
      "import": "./dist/types/index.js",
      "types": "./dist/types/index.d.ts"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc",
    "lint": "tsc --noEmit",
    "test": "vitest"
  },
  "keywords": ["portfolio", "cv", "data"],
  "author": "Andrés Rodríguez Pisa",
  "license": "ISC",
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
